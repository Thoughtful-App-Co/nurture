# Nurture Environment Variables
# Copy this file to .env and update with your values

# Clerk (Third-party auth - not currently used)
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_Y2xvc2UtbWFsYW11dGUtMzIuY2xlcmsuYWNjb3VudHMuZGV2JA

# ============================================================================
# Authentication Testing
# ============================================================================

# Use DemoAuth instead of Anonymous Authentication
# 
# WARNING: DemoAuth creates NEW accounts on every app restart!
# This is ONLY for testing scenarios where you want fresh accounts.
#
# When to use true:
# - Testing onboarding flow repeatedly
# - Testing data mining with different contact sets
# - Simulating first-time user experience
# - QA testing of fresh installs
#
# When to use false (DEFAULT):
# - Normal development work
# - Testing features that require persistent data
# - Production-like behavior
# - Multi-session workflows
#
# Default: false (recommended)
EXPO_PUBLIC_USE_DEMO_AUTH=false

# ============================================================================
# How to use:
# ============================================================================
# 1. Copy this file: cp .env.example .env
# 2. Edit .env with your values
# 3. Restart Metro bundler: npm start --clear
# 4. Changes to .env require Metro restart to take effect
